FOUNDRY_OUT=out

# RPC URL for Sepolia testnet
# You can get this from Infura, Alchemy, or other providers
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# RPC URL for Ethereum Mainnet network
# You can get this from Infura, Alchemy, or other providers
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Etherscan API key for contract verification
# Get this from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Private key of the deployer account
# This account needs to have Sepolia ETH for gas
PRIVATE_KEY=YOUR_PRIVATE_KEY

# Owner address for the contracts
# This can be the same as the deployer or a different address
STABLE_COINS_STAKING_OWNER_ADDRESS=0xYOUR_STABLE_COINS_STAKING_OWNER_ADDRESS
STABLE_BOND_COINS_OWNER_ADDRESS=0xYOUR_STABLE_BOND_COINS_OWNER_ADDRESS
BOND_NFT_OWNER_ADDRESS=0xYOUR_BOND_NFT_OWNER_ADDRESS

# For StableBondCoins deployment
# Initially, this can be set to the same as the owner
# Later, it will be set to the NFT staking contract address
MINTER_ADDRESS=0xYOUR_INITIAL_MINTER_ADDRESS

# After deploying StableBondCoins, set these to its addresses
STABLES_PROXY_ADDRESS=0xYOUR_DEPLOYED_STABLES_PROXY_ADDRESS
STABLES_IMPL_ADDRESS=0xYOUR_DEPLOYED_STABLES_IMPL_ADDRESS

# After deploying NFTStakingAndBorrowing, set these to its addresses
NFT_STAKING_PROXY_ADDRESS=0xYOUR_DEPLOYED_NFT_STAKING_PROXY_ADDRESS
NFT_STAKING_IMPL_ADDRESS=0xYOUR_DEPLOYED_NFT_STAKING_IMPL_ADDRESS

# After deploying BondNFT, set these to its addresses
BOND_NFT_PROXY_ADDRESS=0xYOUR_DEPLOYED_BOND_NFT_PROXY_ADDRESS
BOND_NFT_IMPL_ADDRESS=0xYOUR_DEPLOYED_BOND_NFT_IMPL_ADDRESS

# After deploying StableCoinsStaking, set these to its addresses
STABLES_STAKING_PROXY_ADDRESS=0xYOUR_DEPLOYED_STABLES_STAKING_PROXY_ADDRESS
STABLES_STAKING_IMPL_ADDRESS=0xYOUR_DEPLOYED_STABLES_STAKING_IMPL_ADDRESS

# Gas limit for Ethereum transactions (in wei)
# GAS_LIMIT=500000
