FOUNDRY_OUT=out

# RPC URL for Sepolia testnet
# You can get this from Infura, Alchemy, or other providers
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# RPC URL for Ethereum Mainnet network
# You can get this from Infura, Alchemy, or other providers
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Etherscan API key for contract verification
# Get this from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Private key of the deployer account
# This account needs to have Sepolia ETH for gas
PRIVATE_KEY=YOUR_PRIVATE_KEY

# Owner address for the contracts
# This can be the same as the deployer or a different address
STABLE_COINS_STAKING_OWNER_ADDRESS=0xYOUR_STABLE_COINS_STAKING_OWNER_ADDRESS
STABLE_BOND_COINS_OWNER_ADDRESS=0xYOUR_STABLE_BOND_COINS_OWNER_ADDRESS
BOND_NFT_OWNER_ADDRESS=0xYOUR_BOND_NFT_OWNER_ADDRESS

# For StableBondCoins deployment
# Initially, this can be set to the same as the owner
# Later, it will be set to the NFT staking contract address
MINTER_ADDRESS=0xYOUR_INITIAL_MINTER_ADDRESS

# After deploying StableBondCoins, set this to its address
STABLES_ADDRESS=0xYOUR_DEPLOYED_STABLES_ADDRESS

# After deploying NFTStakingAndBorrowing, set this to its address
NFT_STAKING_ADDRESS=0xYOUR_DEPLOYED_NFT_STAKING_ADDRESS

